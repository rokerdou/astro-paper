---
import { SITE } from "@/config";
import "@/styles/global.css";

export interface Props {
  title?: string;
  activeNav?: "posts" | "tags";
  section?: string;
}

const { title = `Admin | ${SITE.title}`, activeNav = "posts", section } = Astro.props;

const sectionLabel = section || (activeNav === "tags" ? "Tags" : "Posts");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body>
    <div class="admin-shell">
      <div class="admin-header">
        <a href="/" class="admin-brand">{SITE.title}</a>
        <span class="admin-sep">/</span>
        <a href="/admin" class="admin-brand admin-brand--muted">Admin</a>
        <span class="admin-sep">/</span>
        <span class="admin-section">{sectionLabel}</span>
      </div>

      <nav class="admin-nav">
        <a href="/admin" class:list={[activeNav === "posts" && "active"]}>Posts</a>
        <a href="/admin/tags" class:list={[activeNav === "tags" && "active"]}>Tags</a>
        <div class="admin-nav-right">
          <a href="/">View Site &rarr;</a>
        </div>
      </nav>

      <slot />
    </div>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--background);
    color: var(--foreground);
  }

  .admin-shell {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: 2rem 3rem 4rem;
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
  }

  .admin-header {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .admin-brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color 0.15s;
  }

  .admin-brand:hover {
    color: var(--accent);
  }

  .admin-brand--muted {
    color: var(--muted-foreground);
  }

  .admin-sep {
    color: var(--border);
    font-weight: 300;
    user-select: none;
  }

  .admin-section {
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .admin-nav {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .admin-nav a {
    padding: 0.625rem 1rem;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .admin-nav a:hover {
    color: var(--foreground);
  }

  .admin-nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .admin-nav-right {
    margin-left: auto;
  }

  .admin-nav-right a {
    font-size: 0.6875rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .admin-shell { padding: 1rem 1rem 3rem; }
    .admin-header { gap: 0.375rem; }
    .admin-brand, .admin-section { font-size: 1rem; }
    .admin-nav a { padding: 0.5rem 0.75rem; }
  }
</style>
