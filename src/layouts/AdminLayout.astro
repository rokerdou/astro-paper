---
import { SITE } from "@/config";
import { getRuntimeSiteSettings } from "@/utils/siteSettings";
import themeScript from "../../public/toggle-theme.js?raw";
import "@/styles/global.css";

export interface Props {
  title?: string;
  activeNav?: "posts" | "tags" | "comments" | "settings";
  section?: string;
}

const {
  title = `Admin | ${SITE.title}`,
  activeNav = "posts",
  section,
} = Astro.props;
const siteSettings = await getRuntimeSiteSettings(Astro.locals);

const navItems = [
  {
    key: "posts",
    label: "Posts",
    href: "/admin",
    detail: "Drafts and publishing",
    icon: "M5 5.75A2.75 2.75 0 0 1 7.75 3h8.5A2.75 2.75 0 0 1 19 5.75v12.5A1.75 1.75 0 0 1 16.25 19L12 16.45 7.75 19A1.75 1.75 0 0 1 5 17.25V5.75Zm4 2h6m-6 3h6m-6 3h4",
  },
  {
    key: "tags",
    label: "Tags",
    href: "/admin/tags",
    detail: "Content taxonomy",
    icon: "M4 7.75A2.75 2.75 0 0 1 6.75 5h5.1c.73 0 1.43.29 1.94.8l4.4 4.4a2.75 2.75 0 0 1 0 3.9l-4.1 4.1a2.75 2.75 0 0 1-3.89 0l-5.4-5.4A2.75 2.75 0 0 1 4 10.85v-3.1Zm4 .75h.01",
  },
  {
    key: "comments",
    label: "Comments",
    href: "/admin/comments",
    detail: "Moderation queue",
    icon: "M5 6.75A2.75 2.75 0 0 1 7.75 4h8.5A2.75 2.75 0 0 1 19 6.75v5.5A2.75 2.75 0 0 1 16.25 15H11l-4.25 3v-3A2.75 2.75 0 0 1 4 12.25v-5.5h1Z",
  },
  {
    key: "settings",
    label: "Settings",
    href: "/admin/settings",
    detail: "Site metadata",
    icon: "M12 8.5A3.5 3.5 0 1 1 12 15.5 3.5 3.5 0 0 1 12 8.5Zm7.3 2.15-1.35-.45a6.5 6.5 0 0 0-.72-1.72l.64-1.27-1.08-1.08-1.27.64a6.5 6.5 0 0 0-1.72-.72l-.45-1.35h-1.53l-.45 1.35a6.5 6.5 0 0 0-1.72.72l-1.27-.64-1.08 1.08.64 1.27a6.5 6.5 0 0 0-.72 1.72l-1.35.45v1.53l1.35.45c.16.61.4 1.19.72 1.72l-.64 1.27 1.08 1.08 1.27-.64c.53.32 1.11.56 1.72.72l.45 1.35h1.53l.45-1.35c.61-.16 1.19-.4 1.72-.72l1.27.64 1.08-1.08-.64-1.27c.32-.53.56-1.11.72-1.72l1.35-.45v-1.53Z",
  },
] as const;

const sectionLabel =
  section ||
  (activeNav === "tags"
    ? "Tags"
    : activeNav === "comments"
      ? "Comments"
      : activeNav === "settings"
        ? "Settings"
        : "Posts");
const pageTitle =
  title === `Admin | ${SITE.title}` ? `Admin | ${siteSettings.title}` : title;
const sectionDescription =
  activeNav === "tags"
    ? "Organize topics, reuse labels, and keep tag pages tidy."
    : activeNav === "comments"
      ? "Review new replies before they become public."
      : activeNav === "settings"
        ? "Edit server-rendered site identity, SEO metadata, and footer links."
        : section === "New Post"
          ? "Create a searchable, SEO-ready article from Markdown."
          : section === "Edit Post"
            ? "Update content, metadata, tags, and publishing state."
            : "Manage articles, drafts, publishing status, and quick edits.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a href="#admin-main" class="admin-skip">Skip to admin content</a>
    <div class="admin-shell">
      <aside class="admin-sidebar" aria-label="Admin navigation">
        <div class="admin-brand-block">
          <a href="/admin" class="admin-brand" aria-label="Admin home">
            <span class="admin-brand-mark">A</span>
            <span class="admin-brand-copy">
              <span>{siteSettings.title}</span>
              <span>Cloudflare CMS</span>
            </span>
          </a>
        </div>

        <nav class="admin-nav">
          {
            navItems.map(item => (
              <a
                href={item.href}
                class:list={[activeNav === item.key && "active"]}
                aria-current={activeNav === item.key ? "page" : undefined}
              >
                <svg
                  class="admin-nav-icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={item.icon} />
                </svg>
                <span>
                  <span class="admin-nav-label">{item.label}</span>
                  <span class="admin-nav-detail">{item.detail}</span>
                </span>
              </a>
            ))
          }
        </nav>

        <div class="admin-sidebar-footer">
          <a href="/" class="admin-site-link">Public site</a>
        </div>
      </aside>

      <main id="admin-main" class="admin-main">
        <div class="admin-utilitybar" aria-label="Admin quick actions">
          <a href="/" class="admin-icon-action" title="View public site">
            <span class="sr-only">View public site</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 5.75A1.75 1.75 0 0 1 5.75 4h12.5A1.75 1.75 0 0 1 20 5.75v8.5A1.75 1.75 0 0 1 18.25 16H5.75A1.75 1.75 0 0 1 4 14.25v-8.5ZM8 20h8m-4-4v4"
              ></path>
            </svg>
          </a>
          <a
            href="/admin/settings"
            class="admin-icon-action"
            title="Site settings"
          >
            <span class="sr-only">Site settings</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 8.5A3.5 3.5 0 1 1 12 15.5 3.5 3.5 0 0 1 12 8.5Zm7.3 2.15-1.35-.45a6.5 6.5 0 0 0-.72-1.72l.64-1.27-1.08-1.08-1.27.64a6.5 6.5 0 0 0-1.72-.72l-.45-1.35h-1.53l-.45 1.35a6.5 6.5 0 0 0-1.72.72l-1.27-.64-1.08 1.08.64 1.27a6.5 6.5 0 0 0-.72 1.72l-1.35.45v1.53l1.35.45c.16.61.4 1.19.72 1.72l-.64 1.27 1.08 1.08 1.27-.64c.53.32 1.11.56 1.72.72l.45 1.35h1.53l.45-1.35c.61-.16 1.19-.4 1.72-.72l1.27.64 1.08-1.08-.64-1.27c.32-.53.56-1.11.72-1.72l1.35-.45v-1.53Z"
              ></path>
            </svg>
          </a>
          {
            activeNav === "posts" && !section && (
              <a href="/admin/posts/new" class="admin-quick-compose">
                New Post
              </a>
            )
          }
        </div>

        <header class="admin-topbar">
          <div>
            <div class="admin-breadcrumb">
              <a href="/">Site</a>
              <span>/</span>
              <a href="/admin">Admin</a>
            </div>
            <h1>{sectionLabel}</h1>
            <p>{sectionDescription}</p>
          </div>
        </header>

        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --admin-background: #ffffff;
    --admin-foreground: #000000;
    --admin-muted: #fafafa;
    --admin-muted-foreground: #666666;
    --admin-foreground-subtle: #333333;
    --admin-foreground-muted: #8b8b8b;
    --admin-border: #e5e5e5;
    --admin-border-strong: #d0d0d0;
    --admin-surface-hover: #f5f5f5;
    --admin-primary: #000000;
    --admin-primary-foreground: #ffffff;
    --admin-focus: rgba(16, 185, 129, 0.35);
    --admin-success: #10b981;
    --admin-radius-tight: 6px;
    --admin-radius-standard: 8px;
    --admin-radius-relaxed: 10px;
    --admin-shadow-shallow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --admin-shadow-medium: 0 2px 4px 0 rgba(0, 0, 0, 0.08);
    --admin-shadow-focus: 0 0 0 3px var(--admin-focus);
    --background: var(--admin-background);
    --foreground: var(--admin-foreground);
    --muted: var(--admin-muted);
    --muted-foreground: var(--admin-muted-foreground);
    --border: var(--admin-border);
    --accent: var(--admin-primary);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--admin-background);
    color: var(--admin-foreground);
  }

  .admin-skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    border-radius: 0.5rem;
    background: var(--admin-foreground);
    color: var(--admin-background);
    padding: 0.625rem 0.875rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 700;
    transition: top 0.15s ease;
  }

  .admin-skip:focus {
    top: 1rem;
  }

  .admin-shell {
    width: 100%;
    min-height: 100dvh;
    margin: 0;
    padding: 0;
    font-family:
      ui-sans-serif,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      "PingFang SC",
      "Noto Sans SC",
      sans-serif;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 0;
  }

  .admin-sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--admin-border);
    background: var(--admin-background);
    box-shadow: none;
    overflow: hidden;
  }

  .admin-brand-block {
    min-height: 4rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--admin-border);
    display: flex;
    align-items: center;
  }

  .admin-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--admin-foreground);
    text-decoration: none;
  }

  .admin-brand-mark {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-standard);
    background: var(--admin-background);
    box-shadow: var(--admin-shadow-shallow);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0;
  }

  .admin-brand-copy {
    display: grid;
    min-width: 0;
  }

  .admin-brand-copy span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 850;
    line-height: 1.15;
  }

  .admin-brand-copy span:last-child {
    display: block;
    margin-top: 0.1875rem;
    color: var(--admin-muted-foreground);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .admin-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
  }

  .admin-nav a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid transparent;
    min-height: 2rem;
    border-radius: var(--admin-radius-standard);
    padding: 0 0.75rem;
    color: var(--admin-muted-foreground);
    text-decoration: none;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .admin-nav a:hover {
    color: var(--admin-foreground);
    border-color: transparent;
    background: var(--admin-surface-hover);
  }

  .admin-nav a.active {
    color: var(--admin-primary-foreground);
    border-color: var(--admin-primary);
    background: var(--admin-primary);
    box-shadow: var(--admin-shadow-shallow);
  }

  .admin-nav-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-nav-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .admin-nav-detail {
    display: none;
    margin-top: 0.0625rem;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--admin-foreground-muted);
  }

  .admin-sidebar-footer {
    margin-top: auto;
    padding: 0.75rem;
    border-top: 1px solid var(--admin-border);
  }

  .admin-site-link {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-standard);
    color: var(--admin-muted-foreground);
    background: var(--admin-background);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .admin-site-link:hover {
    color: var(--admin-foreground);
    border-color: var(--admin-border-strong);
    background: var(--admin-surface-hover);
  }

  .admin-main {
    min-width: 0;
    padding: 0 1.5rem 3rem;
  }

  .admin-utilitybar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    border-bottom: 1px solid var(--admin-border);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px);
  }

  .admin-icon-action,
  .admin-quick-compose {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--admin-border);
    border-radius: var(--admin-radius-standard);
    background: var(--admin-background);
    color: var(--admin-foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 750;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.12s ease;
  }

  .admin-icon-action {
    width: 2rem;
  }

  .admin-icon-action svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-quick-compose {
    padding: 0 0.875rem;
    background: var(--admin-primary);
    border-color: var(--admin-primary);
    color: var(--admin-primary-foreground);
  }

  .admin-icon-action:hover,
  .admin-quick-compose:hover {
    transform: none;
    border-color: var(--admin-border-strong);
    background: var(--admin-surface-hover);
    color: var(--admin-foreground);
  }

  .admin-quick-compose:hover {
    background: #1a1a1a;
    color: var(--admin-primary-foreground);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .admin-topbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.75rem;
    width: min(100%, 72rem);
    margin: 0 auto 1rem;
    padding: 1.25rem 0 1rem;
  }

  .admin-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--admin-muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .admin-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .admin-breadcrumb a:hover {
    color: var(--admin-foreground);
  }

  .admin-topbar h1 {
    margin: 0.5rem 0 0;
    color: var(--admin-foreground);
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: 0;
  }

  .admin-topbar p {
    max-width: 42rem;
    margin: 0.5rem 0 0;
    color: var(--admin-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .admin-top-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: var(--accent);
    color: #fff;
    padding: 0 1rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 800;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .admin-top-action:hover {
    opacity: 0.88;
  }

  @media (max-width: 900px) {
    .admin-shell {
      display: block;
      padding: 0;
    }

    .admin-sidebar {
      position: static;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--admin-border);
    }

    .admin-brand-block {
      min-height: 3.5rem;
      padding: 0 1rem;
    }

    .admin-nav {
      flex-direction: row;
      overflow-x: auto;
      padding: 0.625rem;
    }

    .admin-nav a {
      min-width: 8rem;
    }

    .admin-sidebar-footer {
      display: none;
    }

    .admin-topbar {
      min-height: 0;
      align-items: flex-start;
      padding: 1rem 0 0.75rem;
      margin-bottom: 1rem;
    }

    .admin-main {
      padding: 0 1rem 3rem;
    }

    .admin-utilitybar {
      min-height: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .admin-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
    }

    .admin-nav a {
      min-width: 0;
    }

    .admin-topbar {
      flex-direction: column;
    }

    .admin-main {
      padding-inline: 0.875rem;
    }
  }
</style>
