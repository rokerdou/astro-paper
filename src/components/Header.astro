---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { getRuntimeTopTags } from "@/utils/runtimePosts";
import { getD1 } from "@/utils/cloudflare";
import { getRuntimeSiteSettings } from "@/utils/siteSettings";

const { pathname } = Astro.url;
const siteSettings = await getRuntimeSiteSettings(Astro.locals);

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// 获取所有 tags 用于导航栏显示
let allTags: Awaited<ReturnType<typeof getRuntimeTopTags>> = [];
try {
  allTags = await getRuntimeTopTags(getD1(Astro.locals), 6);
} catch {
  allTags = [];
}

// 选择最常用的几个 tags 显示在导航栏（最多显示6个）
const topTags = allTags.slice(0, 6).map(({ tag, tagName }) => ({
  name: tagName,
  path: `/tags/${tag}/`,
}));
---

<header
  class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl dark:bg-[#1a1a1a]/90"
>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>

  {/* 主导航栏 */}
  <div class="mx-auto max-w-7xl">
    <div class="flex h-16 items-center justify-between px-4 sm:px-6">
      {/* Logo */}
      <div class="flex flex-shrink-0 items-center">
        <a href="/" class="group flex items-center gap-3">
          <div
            class="rounded-[8px] bg-foreground px-2 py-1 font-mono text-xs font-semibold text-background transition-transform group-hover:scale-105"
          >
            &lt;/&gt;
          </div>
          <span
            class="text-lg font-semibold tracking-tight transition-colors group-hover:text-accent"
          >
            {siteSettings.title}
          </span>
        </a>
      </div>

      {/* 桌面端右侧导航 */}
      <div class="hidden min-w-0 items-center gap-4 md:flex lg:gap-6">
        <nav
          aria-label="Top tags"
          class="hidden min-w-0 items-center gap-1 overflow-hidden border-r border-border pr-4 lg:flex lg:pr-6"
        >
          {
            topTags.map((tag, index) => (
              <>
                <a
                  href={tag.path}
                  class:list={[
                    "truncate rounded-[8px] px-2 py-1 text-sm font-medium transition-colors",
                    isActive(tag.path)
                      ? "bg-muted text-foreground"
                      : "text-foreground/60 hover:text-foreground",
                  ]}
                >
                  {tag.name}
                </a>
                {index < topTags.length - 1 && (
                  <span class="text-xs text-border">/</span>
                )}
              </>
            ))
          }
        </nav>
        <a
          href="/about"
          class="rounded-[8px] px-2 py-1 text-sm font-medium text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
        >
          ABOUT
        </a>
        <a
          href="/rss.xml"
          class="flex items-center gap-1 rounded-[8px] px-2 py-1 text-sm font-medium text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
        >
          RSS
          <IconRss width={12} height={12} class="stroke-current" />
        </a>
        <LinkButton
          href="/search"
          class="rounded-[8px] p-1.5 text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
          ariaLabel="search"
          title="Search"
        >
          <IconSearch width={20} height={20} />
          <span class="sr-only">Search</span>
        </LinkButton>
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative rounded-[8px] p-1.5 text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
              title="Toggle theme"
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon
                width={20}
                height={20}
                class="scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
              />
              <IconSunHigh
                width={20}
                height={20}
                class="absolute top-0 left-0 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
              />
            </button>
          )
        }
      </div>

      {/* 移动端菜单按钮 */}
      <div class="flex items-center gap-4 md:hidden">
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn-mobile"
              class="focus-outline relative rounded-[8px] p-2 text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
              title="Toggle theme"
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon
                width={20}
                height={20}
                class="scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
              />
              <IconSunHigh
                width={20}
                height={20}
                class="absolute top-0 left-0 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
              />
            </button>
          )
        }
        <button
          id="menu-btn"
          class="focus-outline rounded-[8px] p-2 text-foreground hover:bg-muted"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" width={24} height={24} />
          <IconMenuDeep id="menu-icon" width={24} height={24} />
        </button>
      </div>
    </div>
  </div>

  {/* 移动端菜单 */}
  <div
    id="menu-items"
    class="hidden border-t border-border bg-card md:hidden dark:bg-[#1a1a1a]"
  >
    <div class="space-y-1 px-2 pt-2 pb-3">
      <a
        href="/posts"
        class="block rounded-[8px] px-3 py-2 text-base font-medium text-foreground/80 hover:bg-muted hover:text-foreground"
      >
        Posts
      </a>
      <a
        href="/tags"
        class="block rounded-[8px] px-3 py-2 text-base font-medium text-foreground/80 hover:bg-muted hover:text-foreground"
      >
        Tags
      </a>
      <a
        href="/search"
        class="block rounded-[8px] px-3 py-2 text-base font-medium text-foreground/80 hover:bg-muted hover:text-foreground"
      >
        Search
      </a>
      <div class="my-2 border-t border-border"></div>
      <a
        href="/about"
        class="block rounded-[8px] px-3 py-2 text-base font-medium text-foreground/80 hover:bg-muted hover:text-foreground"
      >
        About
      </a>
      <a
        href="/rss.xml"
        class="block rounded-[8px] px-3 py-2 text-base font-medium text-foreground/80 hover:bg-muted hover:text-foreground"
      >
        RSS
      </a>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
