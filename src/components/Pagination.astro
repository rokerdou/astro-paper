---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

export interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: {
      prev?: string;
      next?: string;
    };
  };
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="flex items-center justify-center gap-3" aria-label="Pagination">
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "inline-flex h-9 items-center gap-2 rounded-[8px] border border-border bg-card px-3 text-sm font-medium transition-colors select-none hover:bg-muted",
          { "cursor-not-allowed opacity-50": !page.url.prev },
        ]}
        ariaLabel="Previous"
      >
        <IconArrowLeft
          class="inline-block rtl:rotate-180"
          width={16}
          height={16}
        />
        Prev
      </LinkButton>
      <span class="font-mono text-xs font-medium text-muted-foreground">
        {page.currentPage} / {page.lastPage}
      </span>
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "inline-flex h-9 items-center gap-2 rounded-[8px] border border-border bg-card px-3 text-sm font-medium transition-colors select-none hover:bg-muted",
          { "cursor-not-allowed opacity-50": !page.url.next },
        ]}
        ariaLabel="Next"
      >
        Next
        <IconArrowRight
          class="inline-block rtl:rotate-180"
          width={16}
          height={16}
        />
      </LinkButton>
    </nav>
  )
}
