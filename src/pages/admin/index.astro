---
import Layout from "@/layouts/Layout.astro";
import QueryProvider from "@/components/react/QueryProvider";
import PostList from "@/components/react/admin/PostList";
import { SITE } from "@/config";

export const prerender = false;
---

<Layout title={`Admin | ${SITE.title}`}>
  <div style="max-width: 56rem; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">
      <a href="/" style="color: var(--foreground); text-decoration: none;">{SITE.title}</a>
      <span style="color: var(--accent);"> / Admin</span>
    </h1>
    <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
      <a href="/admin" style="color: var(--accent); font-weight: 500;">Posts</a>
      <a href="/admin/tags" style="color: var(--foreground); opacity: 0.7;">Tags</a>
    </div>
    <QueryProvider client:load>
      <PostList />
    </QueryProvider>
  </div>
</Layout>
