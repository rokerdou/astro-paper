---
export const prerender = false;
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Tag from "@/components/Tag.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRuntimePublishedTags } from "@/utils/runtimePosts";
import { getD1 } from "@/utils/cloudflare";
import { SITE } from "@/config";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30");

const tags = await getRuntimePublishedTags(getD1(Astro.locals));
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Tags" pageDesc="All the tags used in posts.">
    <ul>
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} size="lg" />)}
    </ul>
  </Main>
  <Footer />
</Layout>
