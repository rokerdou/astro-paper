---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getRuntimeTagPostPage } from "@/utils/runtimePosts";
import { getD1 } from "@/utils/cloudflare";
import { SITE } from "@/config";
import NotFoundPage from "@/components/NotFoundPage.astro";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30");

const params = Astro.params;
const { tag } = params;
const pageParam = Array.isArray(Astro.params.page)
  ? Astro.params.page[0]
  : Astro.params.page;
const rawPage = pageParam ?? "1";
const currentPage = /^\d+$/.test(rawPage) ? Number(rawPage) : 0;
const result = tag
  ? await getRuntimeTagPostPage(
      getD1(Astro.locals),
      tag,
      Math.max(currentPage, 1),
      SITE.postPerPage
    )
  : null;

const isMissing =
  !tag ||
  !result ||
  currentPage < 1 ||
  (result && currentPage > result.page.lastPage);
if (isMissing) Astro.response.status = 404;

const tagName = result?.tagName ?? "";
const page = result?.page;
---

{
  isMissing || !page ? (
    <NotFoundPage />
  ) : (
    <Layout title={`Tag: ${tagName} | ${SITE.title}`}>
      <Header />
      <Breadcrumb />
      <main
        id="main-content"
        class="mx-auto w-full max-w-7xl flex-grow px-4 py-8 sm:px-6"
      >
        {/* 页面标题 */}
        <div class="mb-8">
          <h1 class="text-2xl font-semibold sm:text-3xl">
            Tag:{" "}
            <span transition:name={tag} class="text-accent">
              {tagName}
            </span>
          </h1>
          <p class="mt-2 text-muted-foreground italic">
            All the articles with the tag "{tagName}".
          </p>
        </div>

        {/* 网格布局 */}
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {page.data.map(data => (
            <Card variant="h3" {...data} />
          ))}
        </div>

        {/* 分页 */}
        {page.lastPage > 1 && (
          <div class="mt-12">
            <Pagination {page} />
          </div>
        )}
      </main>

      <Footer noMarginTop />
    </Layout>
  )
}
