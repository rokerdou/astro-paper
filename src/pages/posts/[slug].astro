---
export const prerender = false;
import PostDetails from "@/layouts/PostDetails.astro";
import { getRuntimeAdjacentPosts, getRuntimePost } from "@/utils/runtimePosts";
import { getD1 } from "@/utils/cloudflare";
import NotFoundPage from "@/components/NotFoundPage.astro";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30");

const slug = Astro.params.slug;
const db = getD1(Astro.locals);
const post = slug ? await getRuntimePost(db, slug) : null;

if (!post) {
  Astro.response.status = 404;
}

const adjacentPosts = post
  ? await getRuntimeAdjacentPosts(db, post)
  : { previous: null, next: null };
---

{
  post ? (
    <PostDetails
      post={post}
      previousPost={adjacentPosts.previous}
      nextPost={adjacentPosts.next}
    />
  ) : (
    <NotFoundPage />
  )
}
