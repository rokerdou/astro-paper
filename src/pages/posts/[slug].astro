---
export const prerender = false;
import PostDetails from "@/layouts/PostDetails.astro";
import {
  getRuntimeAdjacentPosts,
  getRuntimePost,
} from "@/utils/runtimePosts";
import { getD1 } from "@/utils/cloudflare";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30");

const slug = Astro.params.slug;
const db = getD1(Astro.locals);
const post = slug ? await getRuntimePost(db, slug) : null;

if (!post) {
  if (slug && /^\d+$/.test(slug)) {
    return Astro.redirect(`/posts/page/${slug}/`);
  }
  return Astro.redirect("/404");
}

const adjacentPosts = await getRuntimeAdjacentPosts(db, post);
---

<PostDetails
  post={post}
  previousPost={adjacentPosts.previous}
  nextPost={adjacentPosts.next}
/>
